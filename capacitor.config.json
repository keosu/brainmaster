{
  "appId": "com.brainmaster.app",
  "appName": "Brain Master",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "androidScaleType": "CENTER_CROP",
      "splashFullScreen": true,
      "splashImmersive": true,
      "backgroundColor": "#0a0e1f"
    },
    "StatusBar": {
      "style": "Dark",
      "backgroundColor": "#0a0e1f"
    }
  }
}
