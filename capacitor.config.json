{
  "appId": "com.brainmaster.app",
  "appName": "Brain Master",
  "webDir": "dist",
  "backgroundColor": "#0a0e1f",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "backgroundColor": "#0a0e1f"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "androidScaleType": "CENTER_CROP",
      "splashFullScreen": true,
      "splashImmersive": true,
      "backgroundColor": "#0a0e1f"
    },
    "SystemBars": {
      "insetsHandling": "css",
      "style": "DARK",
      "hidden": true,
      "initialViewportFitValueHint": "cover"
    },
    "StatusBar": {
      "overlaysWebView": true,
      "style": "DARK"
    }
  }
}
